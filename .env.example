# Database Connection String (PostgreSQL)
# Local: postgresql://postgres:postgres@127.0.0.1:5432/pbr_cms
# Supabase (Production / Vercel): Use Supabase Connection Pooler (port 6543 or 5432)
# e.g.: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/pbr_cms

# Payload CMS Secret (used for signing JWT tokens and encryption)
PAYLOAD_SECRET=pbr-super-secret-payload-key-2026-pediatrics-board-review

# Server URL (Set to your Vercel URL in production: https://your-project.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000